FROM alpine:3.22 AS release
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) checksum=53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c ;; \
      arm64) checksum=6c2f3142c94240206123177f4ba1e360daa5d1e0a4962e90757ef4f92c3ab57c ;; \
      *) echo "Unsupported MinIO architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out/licenses; \
    curl --fail --silent --show-error --location --retry 3 \
      "https://github.com/minio/minio/releases/download/RELEASE.2025-04-22T22-12-26Z/minio.linux-${TARGETARCH}.RELEASE.2025-04-22T22-12-26Z" \
      --output /out/minio; \
    printf '%s  /out/minio\n' "$checksum" | sha256sum -c -; \
    chmod 755 /out/minio; \
    for notice in LICENSE CREDITS NOTICE; do \
      curl --fail --silent --show-error --location --retry 3 \
        "https://raw.githubusercontent.com/minio/minio/0d7408fc9969caf07de6a8c3a84f9fbb10a6739e/${notice}" \
        --output "/out/licenses/${notice}"; \
    done

FROM alpine:3.22
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="0d7408fc9969caf07de6a8c3a84f9fbb10a6739e" \
      org.opencontainers.image.version="RELEASE.2025-04-22T22-12-26Z" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
RUN apk add --no-cache ca-certificates curl
COPY --from=release /out/minio /usr/local/bin/minio
COPY --from=release /out/licenses /licenses
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data"]
